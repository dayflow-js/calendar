{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["esnext", "dom", "dom.iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "declaration": true,
    "declarationMap": true,
    "types": ["vitest/globals"],
    "paths": {
      "@/*": ["../../core/src/*"],
      "@dayflow/core": ["../../core/src/caldav-entry.ts"],
      "@dayflow/sync-core": ["../sync-core/src/index.ts"],
      "@sync-core/*": ["../sync-core/src/*"],
      "@google-sync/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
