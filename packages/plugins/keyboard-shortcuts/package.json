{
  "name": "@dayflow/plugin-keyboard-shortcuts",
  "version": "1.6.2",
  "description": "Keyboard shortcuts plugin for DayFlow calendar",
  "keywords": [
    "calendar",
    "dayflow",
    "keyboard",
    "plugin",
    "shortcuts"
  ],
  "homepage": "https://calendar.dayflow.studio/docs/plugins/keyboard-shortcuts",
  "bugs": {
    "url": "https://github.com/dayflow-js/calendar/issues"
  },
  "license": "MIT",
  "author": "Jayce Li",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dayflow-js/calendar.git",
    "directory": "packages/plugins/keyboard-shortcuts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && rollup -c",
    "clean": "rimraf dist node_modules",
    "postbuild": "rimraf dist/types",
    "prebuild": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@dayflow/core": "workspace:^",
    "@rollup/plugin-commonjs": "catalog:",
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-typescript": "catalog:",
    "rimraf": "catalog:",
    "rollup": "catalog:",
    "rollup-plugin-dts": "catalog:",
    "temporal-polyfill": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@dayflow/core": "workspace:^"
  }
}
